# =============================================================================
# 生产构建环境变量 (vite build --mode production 自动加载)
# =============================================================================
# ⚠️⚠️ 2026-10-18 定案：生产构建禁止回落到 .env 的 dev 密钥。
# 本文件由本地预先准备；部署前如密钥已泄漏，请用 openssl rand -hex 24 轮换。
# 生产不走 Vite dev 代理：API 使用 /api/v1 相对路径，由 nginx 反代到后端。
# =============================================================================

VITE_API_BASE_URL=/api/v1

# 生产不使用 dev 代理（nginx 反代），留空即可
VITE_API_TARGET=

VITE_WS_BASE_URL=

# -----------------------------------------------------------------------------
# 安全与加密（下方为本地预生成的随机值；上线前如需轮换请重新生成）
# -----------------------------------------------------------------------------
VITE_API_SECRET=8eb5f3e3e322642dadf0302ca68a9336fb906376388ffbc1
VITE_STORAGE_KEY=f7ab0b6a438572454ec8e25e5d666d2d2d37efd88c4efd49

VITE_USE_MOCK=false
VITE_ENABLE_DEVTOOLS=false
VITE_ENABLE_API_HEALTH_CHECK=true
VITE_ENABLE_WEBSOCKET_NOTIFICATIONS=true

VITE_LOG_LEVEL=warn
VITE_LOG_API_REQUESTS=false
VITE_LOG_API_RESPONSES=false

VITE_REQUEST_TIMEOUT=30000
VITE_REQUEST_RETRY_COUNT=3
VITE_REQUEST_RETRY_DELAY=1000

VITE_APP_TITLE=战略指标管理系统
VITE_APP_DESCRIPTION=Strategic Indicator Management System
VITE_DEFAULT_LOCALE=zh-CN
VITE_DEFAULT_THEME=light
VITE_DEFAULT_PAGE_SIZE=20

VITE_ICP_NUMBER=蜀ICP备2025177084号
VITE_ICP_LINK=https://beian.miit.gov.cn/
