{
  "name": "strategic-assessment-system",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "dev": "node scripts/dev.mjs",
    "arch:check": "node scripts/check-frontend-architecture-debt.cjs",
    "arch:check:update-baseline": "node scripts/check-frontend-architecture-debt.cjs --update-baseline",
    "build": "vite build",
    "build:check": "vite build",
    "build:prod": "vite build --mode production",
    "type-check:strict": "vue-tsc -b",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore",
    "format": "prettier --write \"src/**/*.{ts,vue,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,js,json}\"",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/nprogress": "^0.2.3",
    "axios": "^1.16.1",
    "commitlint": "^20.4.4",
    "dayjs": "^1.11.13",
    "dingtalk-jsapi": "^3.2.9",
    "dotenv": "^17.2.3",
    "echarts": "^5.5.1",
    "element-plus": "^2.12.0",
    "lodash-es": "^4.18.1",
    "nprogress": "^0.2.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.24",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.5.0",
    "write-excel-file": "^4.0.7",
    "zod": "^4.3.6",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.60.0",
    "@rushstack/eslint-patch": "^1.10.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.1",
    "@types/zxcvbn": "^4.4.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.15",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.29.0",
    "fast-check": "^4.4.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^15.2.10",
    "pg": "^8.17.2",
    "prettier": "^3.4.2",
    "sass-embedded": "^1.98.0",
    "terser": "^5.46.0",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.3",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.1.4"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.9"
    }
  }
}
